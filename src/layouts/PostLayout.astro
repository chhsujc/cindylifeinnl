---
import Layout from './Layout.astro';
import { categories } from '../data/site';
import { normalizePost, type PostFrontmatter } from '../data/post';

interface Props { frontmatter: PostFrontmatter; }
const article = normalizePost(Astro.props.frontmatter, Astro.url.pathname);
const category = categories.find(item => item.id === article.category)!;
---
<Layout title={article.title} description={article.excerpt}>
  <article class="article-page container">
    <a class="text-link" href="/notes/">← Back to notes · 所有文章</a>
    <header class="article-header">
      <a class="badge" href={`/${category.id}/`}>{category.en} {category.zh}</a>
      <h1>{article.title}</h1>
      {article.englishTitle && <p class="article-subtitle" lang="en">{article.englishTitle}</p>}
      <div class="article-meta">
        <time datetime={article.date}>{article.date}</time>
        {article.author && <span>{article.author}</span>}
        <span>{article.readingMinutes} min read</span>
      </div>
      {article.sample && <p class="demo-notice">示範文章 · Sample content for this notebook. Replace with your own story.</p>}
    </header>
    {article.image && <img class="article-cover" src={article.image} alt={article.alt} width="1200" height="700" />}
    <div class="prose">
      <slot />
      {article.tags.length > 0 && <div class="tags">{article.tags.map(tag => <a href={`/notes/?tag=${encodeURIComponent(tag)}`}># {tag}</a>)}</div>}
    </div>
  </article>
</Layout>
